{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Forhåndsvis hagen",
      "type": "shell",
      "command": "source \"$HOME/.nvm/nvm.sh\" --no-use && nvm use --silent && pnpm dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lc"
          ]
        }
      }
    },
    {
      "label": "Kontroller før publisering",
      "type": "shell",
      "command": "source \"$HOME/.nvm/nvm.sh\" --no-use && nvm use --silent && pnpm build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/zsh",
          "args": [
            "-lc"
          ]
        }
      }
    }
  ]
}
