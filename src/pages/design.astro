---
import BaseHead from "@/components/BaseHead.astro";
import DesignDevice from "@/components/design/DesignDevice.astro";
// Portfolio draft: edit the copy here and replace DesignDevice slots with project images.
const projects = [
  { id: "prosjekt-en", number: "01", title: "Litt enklere.\nMye bedre.", category: "DIGITAL PRODUKTDESIGN", name: "Prosjekt én", description: "Et lite grep kan gjøre en stor forskjell. Her kommer historien om en digital tjeneste som gjør hverdagen litt lettere.", tone: "peach" as const, type: "Mobilopplevelse", year: "2026" },
  { id: "prosjekt-to", number: "02", title: "Rom for\nnysgjerrighet.", category: "TJENESTEDESIGN & UX", name: "Prosjekt to", description: "Fra mange muligheter til én tydelig retning. Her kommer et prosjekt om å utforske behov og finne frem til det som betyr noe.", tone: "mint" as const, type: "Digital tjeneste", year: "2025" },
  { id: "prosjekt-tre", number: "03", title: "De små tingene.\nDen store følelsen.", category: "VISUELL DESIGN & INTERAKSJON", name: "Prosjekt tre", description: "Når innhold, form og bevegelse spiller sammen. Her kommer et prosjekt der detaljene får lov til å gjøre jobben.", tone: "lavender" as const, type: "Nettside & identitet", year: "2025" },
];
---
<!doctype html>
<html lang="nb">
  <head><BaseHead title="Design — Ding Chen Fjær" description="Utvalgte prosjekter og tanker om design. Portefølje av Ding Chen Fjær." /></head>
  <body class="design-page">
    <a class="skip" href="#innhold">Hopp til innhold</a>
    <header class="navigation">
      <a class="wordmark" href="/" aria-label="Ding Chen Fjær – tilbake til Fjærdinghage">ding<span aria-hidden="true">✳</span></a>
      <nav aria-label="Portefølje"><a href="#prosjekter">Prosjekter</a><a href="#tilnarming">Tilnærming</a><a class="nav-cv" href="/cv/">Min CV <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="innhold">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="dot"></span> DING CHEN FJÆR · DESIGNER</p>
          <h1 id="hero-title">Design som<br />kjennes <em>riktig.</em></h1>
          <p class="intro">Nysgjerrighet først. Mennesker i sentrum.<br />Digitale opplevelser med omtanke i detaljene.</p>
          <a class="button dark" href="#prosjekter">Utforsk prosjektene <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-stage" aria-label="Plassholdere for tre prosjektbilder">
          <div class="orbit orbit-one" aria-hidden="true"></div><div class="orbit orbit-two" aria-hidden="true"></div>
          <span class="stage-note" aria-hidden="true">Små detaljer.<br /><em>Store forskjeller.</em></span>
          <div class="hero-phone left" data-parallax="0.09"><DesignDevice tone="mint" label="Prosjekt 02" /></div>
          <div class="hero-phone center" data-parallax="-0.045"><DesignDevice tone="peach" label="Prosjekt 01" /></div>
          <div class="hero-phone right" data-parallax="0.13"><DesignDevice tone="lavender" label="Prosjekt 03" /></div>
          <span class="asterisk" aria-hidden="true">✳</span>
        </div>
        <div class="hero-bottom"><span>ET UTVALG ARBEIDER</span><span>SCROLL FOR Å UTFORSKE <span aria-hidden="true">↓</span></span><span>2025 — 2026</span></div>
      </section>

      <section class="work section-width" id="prosjekter" aria-labelledby="work-title">
        <div class="section-heading"><div><p class="eyebrow">FRA IDÉ TIL OPPLEVELSE</p><h2 id="work-title">Utvalgte arbeider<span class="orange">.</span></h2></div><p>Ulike utfordringer.<br />Den samme nysgjerrigheten.</p></div>
        {projects.map((project, index) => (
          <article id={project.id} class:list={["project", project.tone]}>
            <div class="project-copy">
              <p class="eyebrow"><span class="project-number">{project.number}</span> {project.category}</p>
              <h3>{project.title.split("\n").map(line => <span>{line}</span>)}</h3>
              <p class="project-description">{project.description}</p>
              <div class="project-tags"><span>{project.name}</span><span>{project.type}</span></div>
              <a class="text-link" href={`#${project.id}-historie`}>Om prosjektet <span aria-hidden="true">↗</span></a>
            </div>
            <div class:list={["project-stage", { "wide-stage": index === 2 }]}>
              <span class="backdrop-circle" aria-hidden="true"></span>
              {index === 0 ? <><div class="project-phone phone-a" data-parallax="0.06"><DesignDevice tone={project.tone} label="Hovedskjerm" /></div><div class="project-phone phone-b" data-parallax="-0.055"><DesignDevice tone={project.tone} label="Detaljvisning" /></div></> : index === 1 ? <><div class="floating-caption" data-parallax="0.1"><span aria-hidden="true">↗</span><span>En ny<br />retning.</span></div><div class="project-phone phone-solo" data-parallax="-0.06"><DesignDevice tone={project.tone} label="Brukeropplevelse" /></div></> : <div class="project-browser" data-parallax="-0.04"><DesignDevice tone={project.tone} label="Nettside / desktop" variant="browser" /></div>}
              <span class="stage-index" aria-hidden="true">{project.number} / 03</span>
            </div>
            <details id={`${project.id}-historie`} class="project-details">
              <summary><span>{project.name} · Prosjektnotater</span><span class="details-toggle" aria-hidden="true">+</span></summary>
              <div class="details-grid"><div><p class="eyebrow">UTFORDRINGEN</p><p>Her kommer bakgrunnen for prosjektet, hvem løsningen er laget for og problemet vi ønsket å løse.</p></div><div><p class="eyebrow">MIN ROLLE</p><p>Her beskrives mitt bidrag, samarbeidet med teamet og valgene som formet løsningen.</p></div><div><p class="eyebrow">DET JEG TAR MED VIDERE</p><p>Her kommer læring, resultater og refleksjoner fra arbeidet.</p></div></div>
            </details>
          </article>
        ))}
      </section>

      <section class="approach section-width" id="tilnarming" aria-labelledby="approach-title">
        <div class="approach-intro"><p class="eyebrow">MÅTEN JEG JOBBER PÅ</p><h2 id="approach-title">Gode spørsmål.<br /><em>Bedre løsninger.</em></h2><p>Design er like mye å lytte som å skape. Her er det plass til å fortelle om prosessen bak arbeidet.</p><span class="approach-flower" aria-hidden="true">✳</span></div>
        <div class="steps">
          <div class="step"><span>01 — FORSTÅ</span><h3>Begynn med menneskene.</h3><p>Her kommer noen ord om innsikt, samtaler og det å finne det egentlige behovet bak en utfordring.</p></div>
          <div class="step"><span>02 — UTFORSKE</span><h3>Gi ideene litt spillerom.</h3><p>Her kommer noen ord om skisser, prototyper og små eksperimenter som åpner for nye muligheter.</p></div>
          <div class="step"><span>03 — FORFINE</span><h3>Omtanke, helt ned i detaljene.</h3><p>Her kommer noen ord om testing, samarbeid og veien fra en lovende idé til en god opplevelse.</p></div>
        </div>
      </section>
      <section class="closing" aria-labelledby="closing-title"><p class="eyebrow">MER OM MEG</p><h2 id="closing-title">Et arbeid i utvikling.<br /><em>Akkurat som meg.</em></h2><p>Flere prosjekter og små oppdagelser kommer etter hvert.</p><div class="closing-links"><a class="button light" href="/about/">Møt designeren <span aria-hidden="true">↗</span></a><a class="closing-cv" href="/cv/">Se min CV <span aria-hidden="true">↗</span></a></div><span class="closing-flower" aria-hidden="true">✳</span></section>
    </main>
    <footer class="design-footer"><a href="/">← Tilbake til Fjærdinghage</a><span>© {new Date().getFullYear()} Ding Chen Fjær</span><a href="#innhold">Til toppen ↑</a></footer>
  </body>
</html>

<script>
  const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  const items = [...document.querySelectorAll<HTMLElement>("[data-parallax]")];
  let pending = false;
  const update = () => {
    pending = false;
    const enabled = !motionQuery.matches && window.innerWidth > 700;
    for (const item of items) {
      const section = item.closest(".hero-stage, .project-stage");
      if (!section) continue;
      const rect = section.getBoundingClientRect();
      const offset = enabled ? Math.max(-65, Math.min(65, (window.innerHeight / 2 - rect.top - rect.height / 2) * Number(item.dataset.parallax))) : 0;
      item.style.setProperty("--drift", `${offset}px`);
    }
  };
  const schedule = () => { if (!pending) { pending = true; requestAnimationFrame(update); } };
  window.addEventListener("scroll", schedule, { passive: true });
  window.addEventListener("resize", schedule, { passive: true });
  motionQuery.addEventListener("change", schedule);
  update();
  document.querySelectorAll<HTMLAnchorElement>(".text-link").forEach(link => {
    link.addEventListener("click", () => {
      const details = document.getElementById(link.hash.slice(1));
      if (details instanceof HTMLDetailsElement) details.open = true;
    });
  });
</script>
