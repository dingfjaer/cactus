---
import PageLayout from "@/layouts/Base.astro";
const baseUrl = import.meta.env.BASE_URL || "";
---

<PageLayout meta={{ title: "cv" }}>
	<section class="mb-6 text-xl">
		<a
			href={`${baseUrl}cv-dingchen-trumf-2026.pdf`}
			class="text-accent sm:hover:underline"
			target="_blank"
			rel="noopener noreferrer">CV-en oppdatert for Trumf 2026</a
		>
	</section>
	<section class="mb-6 text-xl">
		<a
			href={`${baseUrl}cv-2024.pdf`}
			class="text-accent sm:hover:underline"
			target="_blank"
			rel="noopener noreferrer">CV-en oppdatert 2024</a
		>
	</section>

</PageLayout>
