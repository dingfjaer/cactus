---
import AboutName from "@/components/AboutName.astro";
import AboutPortrait from "@/components/AboutPortrait.astro";
import DingLogo3D from "@/components/DingLogo3D.astro";
import PageLayout from "@/layouts/Base.astro";
const baseUrl = import.meta.env.BASE_URL || Astro.site?.toString() || "";
---

<PageLayout meta={{ title: "portfolio" }}>
	<div class="about-hero" id="about-top">
		<DingLogo3D edgeToEdge />
	</div>
	<AboutName />
	<AboutPortrait />

	<div class="mt-12">
		<section class="mb-6 text-xl">
			<a
				href={`${baseUrl}dings-apps.pdf`}
				class="text-accent sm:hover:underline"
				target="_blank"
				rel="noopener noreferrer">Hobbyprosjekter: iOS-apper bygget med AI (2026)</a
			>
		</section>

		<section class="mb-6 text-xl">
			<a
				href="https://www.figma.com/proto/dIULhitI3aG6HagQdU6cRC/dingchen.no?page-id=0%3A1&type=design&node-id=12-205&viewport=729%2C139%2C0.16&t=iMVKlHhdlVCH74Va-1&scaling=scale-down-width&starting-point-node-id=12%3A205"
				class="text-accent sm:hover:underline"
				target="_blank"
				rel="noopener noreferrer"
				>Portfolio i Figma: en interaktiv prototype bygget uten AI (2024)</a
			>
		</section>

		<section class="mb-6 text-xl">
			<a
				href={`${baseUrl}portfolio.pdf`}
				class="text-accent sm:hover:underline"
				target="_blank"
				rel="noopener noreferrer">Portfolio PDF (2024)</a
			>
		</section>

		<section class="mb-6 text-xl">
			<a
				href="https://www.figma.com/proto/3CIZA5BnJ1TLPik4flUTS7/Portef%C3%B8lje-og-s%C3%B8knader?node-id=117-2697&viewport=806%2C533%2C0.04&t=jiZ7vL82vk0yzT4X-1&scaling=scale-down-width&content-scaling=fixed&starting-point-node-id=117%3A2697&page-id=117%3A385"
				class="text-accent sm:hover:underline"
				target="_blank"
				rel="noopener noreferrer">Portfolio til NRK Radio i Figma (2023)</a
			>
		</section>

		<section class="mb-6 text-xl">
			<a
				href={`${baseUrl}portfolio-nrk-radio.pdf`}
				class="text-accent sm:hover:underline"
				target="_blank"
				rel="noopener noreferrer">Portfolio til NRK Radio PDF (2023)</a
			>
		</section>

		<section class="text-muted-foreground mb-6 text-sm">
			<p>
				* Her får det visuelle mest plass. Prosess, samarbeid og kundeoppdrag forteller jeg gjerne
				mer om over en kaffe ☕️.
			</p>
		</section>
	</div>
</PageLayout>

<style>
	.about-hero {
		width: 100vw;
		margin-left: calc(50% - 50vw);
	}
</style>
