---
import PageLayout from "@/layouts/Base.astro";
import NowTimeline from "@/components/NowTimeline.astro";
import { loadNowHistory } from "@/utils/load-now-history";
const history = loadNowHistory();
const base = import.meta.env.BASE_URL;
---

<PageLayout
	meta={{
		title: "Hva skjer nå – over tid",
		description: "Små spor av det jeg gjør, hører på, leser og ser. Fem tidslinjer fra hverdagen.",
	}}
	wide
>
	<header class="now-intro">
		<a class="back-link" href={base}>← Tilbake til hagen</a>
		<p class="eyebrow">Litt av livet, underveis</p>
		<h1>Hva skjer nå<span> – over tid.</span></h1>
		<p class="intro-copy">
			Det jeg driver med, lytter til, leser og ser. Små oppdateringer som blir til en historie.
		</p>
	</header>
	<NowTimeline history={history} preview={import.meta.env.DEV} />
	<p class="timeline-note">
		Datoene følger publiseringen av oppdateringene. Alle klokkeslett er norsk tid.
	</p>
</PageLayout>
<style>
	.now-intro {
		max-width: 680px;
		margin: 0 0 2.5rem;
	}
	.back-link {
		display: inline-block;
		font-size: 0.8rem;
		color: hsl(var(--theme-accent));
		margin-bottom: 2.5rem;
	}
	.back-link:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.back-link:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 4px;
	}
	.eyebrow {
		font-size: 0.65rem;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: hsl(var(--theme-accent));
		margin-bottom: 0.9rem;
	}
	h1 {
		font-size: clamp(2rem, 4vw, 3.4rem);
		line-height: 1.12;
		font-weight: 500;
		letter-spacing: -0.045em;
		color: hsl(var(--theme-accent-2));
	}
	h1 span {
		color: hsl(var(--theme-text) / 0.6);
	}
	.intro-copy {
		margin-top: 1.2rem;
		max-width: 520px;
		font-size: 1rem;
		line-height: 1.75;
	}
	.timeline-note {
		margin: 1.2rem 0 0;
		font-size: 0.7rem;
		line-height: 1.6;
		color: hsl(var(--theme-text) / 0.6);
	}
	@media (max-width: 639px) {
		.now-intro {
			margin-bottom: 1.5rem;
		}
		h1 span {
			display: block;
		}
	}
</style>
