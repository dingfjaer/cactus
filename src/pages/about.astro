---
import AboutPortrait from "@/components/AboutPortrait.astro";
import AboutName from "@/components/AboutName.astro";
import DingLogo3D from "@/components/DingLogo3D.astro";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Om Ding Chen Fjær",
	title: "Om",
};
---

<PageLayout meta={meta}>
	<div class="about-hero" id="about-top">
		<DingLogo3D edgeToEdge />
	</div>
	<AboutName />
	<AboutPortrait />

	<div class="mt-12 flex flex-col items-center gap-3 text-xl">
		<a href="/cv" class="text-accent sm:hover:underline"> CV </a>

		<a href="/portfolio" class="text-accent sm:hover:underline"> Portfolio </a>
	</div>
</PageLayout>

<style>
	.about-hero {
		width: 100vw;
		margin-left: calc(50% - 50vw);
	}
</style>
