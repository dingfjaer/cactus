---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Om Ding Chen Fjær",
	title: "Om",
};
---

<PageLayout meta={meta}>
	<div class="about-image">
		<img src="/images/about.png" alt="Om Ding Chen Fjær" />
	</div>

	<div class="mt-12 flex flex-col items-center gap-3 text-xl">
		<a href="/cv" class="text-accent sm:hover:underline"> CV </a>

		<a href="/portfolio" class="text-accent sm:hover:underline"> Portfolio </a>
	</div>
</PageLayout>

<style>
	.about-image {
		width: 100vw;
		margin-left: calc(50% - 50vw);
	}

	.about-image img {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
