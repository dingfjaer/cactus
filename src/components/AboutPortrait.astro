---
import { Image } from "astro:assets";
import portraitOne from "@/assets/about-portrait/portrait-1.png";
import portraitTwo from "@/assets/about-portrait/portrait-2.png";
const imageProps = {
	widths: [480, 960, 1440, 2048],
	sizes: "(max-aspect-ratio: 2048/2732) 100vw, 75svh",
	format: "webp" as const,
	quality: 90,
	loading: "eager" as const,
	decoding: "async" as const,
};
---

<about-portrait>
	<section class="portrait-section" aria-label="Selvportrett">
		<div class="portrait-scene">
			<Image
				{...imageProps}
				src={portraitOne}
				alt="Illustrert selvportrett av Ding med gule briller, først på hvit og deretter på rød bakgrunn."
			/>
			<div class="portrait-reveal" aria-hidden="true">
				<Image {...imageProps} src={portraitTwo} alt="" />
			</div>
			<div class="portrait-edge" aria-hidden="true"></div>
		</div>
	</section>
</about-portrait>

<script>
	import "../scripts/about-portrait.js";
</script>

<style>
	about-portrait {
		display: block;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		--portrait-height: min(100svh, 133.3984375vw);
	}
	.portrait-section {
		position: relative;
		background: #fff;
	}
	.portrait-scene {
		position: relative;
		height: var(--portrait-height);
		overflow: hidden;
		background: #fff;
		isolation: isolate;
	}
	.portrait-scene img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.portrait-reveal {
		position: absolute;
		inset: 0;
		background: #c60007;
		clip-path: inset(0 0 calc((1 - var(--reveal, 1)) * 100%) 0);
	}
	/* A soft lip follows the reveal; the two drawings never move out of register. */
	.portrait-edge {
		position: absolute;
		left: 0;
		right: 0;
		top: calc(var(--reveal, 1) * 100%);
		height: 24px;
		transform: translateY(-50%);
		background: linear-gradient(transparent, #3c000019 48%, #fff3 53%, transparent);
		opacity: var(--edge, 0);
		pointer-events: none;
	}
	about-portrait[data-enhanced]:not([data-reduced]) .portrait-section::after {
		content: "";
		display: block;
		height: 180svh;
	}
	about-portrait[data-enhanced]:not([data-reduced]) .portrait-scene {
		position: sticky;
		top: calc((100svh - var(--portrait-height)) / 2);
	}
</style>
