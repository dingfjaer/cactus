---
import document from "./index.html?raw";
import "./review.css";
// Preserve the supplied report, without its document metadata or global script.
const content = document.split("</style>")[1].replaceAll('class="prose"', 'class="review-prose"');
const caseUrl = `${import.meta.env.BASE_URL}portfolio/pa-tur/`;
---

<article class="patur-review" aria-label="Claudes gjennomgang av På tur">
	<div class="wrap"><a class="review-return" href={caseUrl}>← Tilbake til På tur-casen</a></div>
	<Fragment set:html={content} />
	<div class="wrap"><a class="review-return" href={caseUrl}>← Tilbake til På tur-casen</a></div>
</article>
