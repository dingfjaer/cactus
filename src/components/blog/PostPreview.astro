---
import type { CollectionEntry } from "astro:content";
import { getPostSortDate } from "@/data/post";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "../FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { as: Tag = "div", post, withDesc = false } = Astro.props;
const postDate = getPostSortDate(post);
const baseUrl = import.meta.env.BASE_URL || Astro.site?.toString() || "";
---

<div class="min-w-[120px] text-gray-600 dark:text-gray-400">
	<FormattedDate date={postDate} />
	{post.data.inProgress && <span class="mt-1 block text-xs text-accent">🌱 Underveis</span>}
</div>
<Tag>
	{
		post.data.pinned && (
			<span class="mr-1 text-sm" role="img" aria-label="Festet innlegg" title="Festet innlegg">
				📌
			</span>
		)
	}
	{post.data.draft && <span class="text-yellow-500">(Kladd) </span>}
	<!-- fikset routing ved å legge til ${Astro.site} -->
	<a
		class="post-title underline-offset-2 transition-colors hover:text-accent hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
		data-astro-prefetch
		href={`${baseUrl}posts/${post.id}/`}
	>
		{post.data.title}
	</a>
</Tag>
{withDesc && <q class="line-clamp-3 italic">{post.data.description}</q>}
