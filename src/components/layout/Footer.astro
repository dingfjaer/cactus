---
import { menuLinks, siteConfig } from "@/site-config";

const currentYear = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL || Astro.site?.toString() || "";
---

<footer
	class="font-regular mt-auto flex w-full flex-col items-center justify-center gap-y-2 pb-4 pt-20 text-center align-top text-xs text-gray-600 dark:text-gray-400 sm:flex-row sm:justify-between"
>
	<div class="me-0 sm:me-4">
		&copy; {siteConfig.author}
		<span data-current-year>{currentYear}</span>.<span class="inline-block">&nbsp;Hva sier reven? </span>
	</div>
	<nav
		aria-label="Mer på dette nettstedet"
		class="flex flex-nowrap gap-x-3 overflow-x-auto sm:gap-x-0 sm:divide-x sm:divide-gray-500"
	>
		{
			menuLinks.map((link) => (
				<a
					class="flex-shrink-0 px-3 py-2 whitespace-nowrap sm:py-0 sm:px-4 sm:hover:text-textColor sm:hover:underline"
					href={`${baseUrl}${link.path}`}
				>
					{link.title}
				</a>
			))
		}
	</nav>
</footer>
<script is:inline>
	const yearElement = document.querySelector("[data-current-year]");
	if (yearElement) {
		yearElement.textContent = new Date().getFullYear().toString();
	}
</script>

<style>
@media (max-width:639px) {
  :global(.garden-page) footer { font-size:clamp(.625rem, 2.8vw, .75rem); }
  :global(.garden-page) footer > div { white-space:nowrap; }
  :global(.garden-page) footer nav { width:100%; flex-wrap:nowrap; justify-content:space-between; gap:.25rem; overflow:visible; }
  :global(.garden-page) footer nav a { padding-inline:0; white-space:nowrap; }
}
</style>
