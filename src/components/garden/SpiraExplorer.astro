---
import type { CollectionEntry } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getPostSortDate } from "@/data/post";
interface Props {
	posts: CollectionEntry<"post">[];
	currentPage: number;
}
const { posts, currentPage } = Astro.props;
const diceFaces = [
	{ side: "front", pips: [1, 3, 5, 7, 9] },
	{ side: "back", pips: [1, 9] },
	{ side: "right", pips: [1, 5, 9] },
	{ side: "left", pips: [1, 3, 7, 9] },
	{ side: "top", pips: [5] },
	{ side: "bottom", pips: [1, 3, 4, 6, 7, 9] },
];
const base = `${import.meta.env.BASE_URL}posts/`;
---

<spira-explorer data-page={currentPage} data-base={base}>
	<div data-enhanced hidden>
		<div class="spira-toolbar">
			<div class="spira-filters" role="group" aria-label="Filtrer innlegg">
				<button type="button" data-filter="alle" aria-pressed="true">Alle</button>
				<button type="button" data-filter="dingaling" aria-pressed="false">DingaLing</button>
				<button type="button" data-filter="ki-oppsummert" aria-pressed="false">KI-oppsummert</button
				>
			</div>
			<button class="dingo" type="button" data-draw aria-label="Dingo – trekk innlegg"
				><span aria-hidden="true">🎲</span> Dingo</button
			>
		</div>
		<div class="spira-description" data-description hidden>
			<h2 data-filter-title></h2><p data-filter-description></p>
		</div>
		<div class="dingo-heading" data-dingo hidden>
			<h2 data-dingo-title></h2>
			<div class="dingo-actions">
				<button type="button" data-again>Trekk på nytt</button><span aria-hidden="true">·</span
				><button type="button" data-latest>Tilbake til nyeste</button>
			</div>
		</div>
		<p class="sr-only" role="status" aria-live="polite" data-status></p>
		<div data-results></div>
		<nav class="spira-pagination" data-pagination aria-label="Bla i filtrerte innlegg">
			<button type="button" data-prev>← Forrige</button><span data-page-label></span><button
				type="button"
				data-next>Neste →</button
			>
		</nav>
	</div>
	<dialog class="dingo-roll" data-roll aria-label="Terningkast – trekker innlegg" tabindex="-1">
		<div class="dice-stage" aria-hidden="true">
			<div class="dice-lift">
				<div class="dice-cube">
					{
						diceFaces.map((face) => (
							<div class={`dice-face dice-face--${face.side}`}>
								{face.pips.map((pip) => (
									<span
										class="dice-pip"
										style={`grid-area: ${Math.ceil(pip / 3)} / ${((pip - 1) % 3) + 1}`}
									/>
								))}
							</div>
						))
					}
				</div>
				<p class="dice-caption">Dingo!</p>
			</div>
		</div>
		<div data-fallback><slot /></div>
		<template data-posts>
			<ul>
				{
					posts.map((post) => (
						<li
							data-id={post.id}
							data-type={post.data.contentType}
							data-year={getPostSortDate(post).getFullYear()}
							data-pinned={String(post.data.pinned)}
							class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2"
						>
							<PostPreview post={post} />
						</li>
					))
				}
			</ul>
		</template>
	</dialog>
	<script>
		import "../../scripts/spira";
	</script>
	<style>
		[hidden] {
			display: none !important;
		}
		spira-explorer {
			display: block;
		}
		.spira-toolbar,
		.spira-filters,
		.dingo-actions,
		.spira-pagination {
			display: flex;
			align-items: center;
			flex-wrap: wrap;
			gap: 0.5rem;
		}
		.spira-toolbar {
			justify-content: space-between;
			gap: 0.75rem;
			margin-bottom: 1.75rem;
		}
		button {
			min-height: 42px;
			padding: 0.5rem 0.75rem;
			border-radius: 0.6rem;
			font-size: 0.85rem;
			transition:
				background 0.15s,
				color 0.15s;
		}
		.spira-filters {
			flex: 1;
			flex-wrap: nowrap;
			gap: 0.5rem;
			border-bottom: 1px solid hsl(var(--theme-text) / 0.25);
		}
		button:hover:not(:disabled) {
			color: hsl(var(--theme-accent));
			background: hsl(var(--theme-text) / 0.08);
		}
		.spira-filters button {
			position: relative;
			padding: 0.7rem 0.5rem;
			border-radius: 0;
			white-space: nowrap;
			color: hsl(var(--theme-text) / 0.65);
		}
		.spira-filters button:hover:not(:disabled),
		.spira-filters button[aria-pressed="true"] {
			color: hsl(var(--theme-accent-2));
			background: transparent;
		}
		.spira-filters button::after {
			content: "";
			position: absolute;
			inset-inline: 0;
			bottom: -1px;
			height: 3px;
			background: hsl(var(--theme-accent));
			opacity: 0;
			transition: opacity 0.15s;
		}
		.spira-filters button[aria-pressed="true"]::after {
			opacity: 1;
		}
		button:focus-visible {
			outline: 2px solid hsl(var(--theme-accent));
			outline-offset: 3px;
		}
		.dingo {
			color: hsl(var(--theme-accent));
			border: 1px dashed hsl(var(--theme-accent) / 0.55);
		}
		.spira-description {
			margin-bottom: 1.8rem;
			font-size: 0.9rem;
			line-height: 1.65;
		}
		h2 {
			color: hsl(var(--theme-accent-2));
			font-weight: 600;
		}
		.spira-description p {
			margin-top: 0.3rem;
		}
		.dingo-heading {
			margin-bottom: 1.6rem;
			padding: 1rem;
			border-radius: 0.8rem;
			background: hsl(var(--theme-accent) / 0.06);
			border-inline-start: 2px solid hsl(var(--theme-accent));
		}
		.dingo-actions {
			gap: 0.3rem;
			margin: 0.4rem 0 -0.4rem -0.5rem;
			color: hsl(var(--theme-accent));
		}
		.dingo-actions button {
			padding-inline: 0.5rem;
		}
		.spira-pagination {
			justify-content: space-between;
			gap: 0.25rem;
			margin-top: 2rem;
			font-size: 0.85rem;
		}
		button:disabled {
			opacity: 0.35;
		}
		.dingo-roll {
			--dice-size: clamp(112px, 18vw, 152px);
			--dice-half: calc(var(--dice-size) / 2);
			position: fixed;
			inset: 0;
			margin: auto;
			width: min(360px, 90vw);
			height: min(340px, 80dvh);
			max-width: none;
			max-height: none;
			padding: 0;
			border: 0;
			overflow: visible;
			background: transparent;
			color: hsl(var(--theme-accent));
			outline: none;
		}
		.dingo-roll::backdrop {
			background: hsl(var(--theme-bg) / 0.7);
			backdrop-filter: blur(4px);
			-webkit-backdrop-filter: blur(4px);
		}
		.dice-stage {
			width: 100%;
			height: 100%;
			display: grid;
			place-content: center;
			justify-items: center;
			perspective: 650px;
		}
		.dice-lift {
			transform-style: preserve-3d;
		}
		.dice-cube {
			position: relative;
			width: var(--dice-size);
			height: var(--dice-size);
			transform-style: preserve-3d;
			transform: rotateX(-20deg) rotateY(-32deg);
		}
		.dice-face {
			position: absolute;
			inset: 0;
			display: grid;
			grid-template: repeat(3, 1fr) / repeat(3, 1fr);
			gap: 12%;
			padding: 17%;
			border-radius: 15%;
			background: linear-gradient(145deg, #ffffff38, #00000012), hsl(var(--theme-accent));
			border: 1px solid hsl(var(--theme-bg) / 0.18);
			box-shadow: inset 0 0 12px #ffffff25;
			backface-visibility: hidden;
		}
		.dice-face--front {
			transform: translateZ(var(--dice-half));
		}
		.dice-face--back {
			transform: rotateY(180deg) translateZ(var(--dice-half));
		}
		.dice-face--right {
			transform: rotateY(90deg) translateZ(var(--dice-half));
		}
		.dice-face--left {
			transform: rotateY(-90deg) translateZ(var(--dice-half));
		}
		.dice-face--top {
			transform: rotateX(90deg) translateZ(var(--dice-half));
		}
		.dice-face--bottom {
			transform: rotateX(-90deg) translateZ(var(--dice-half));
		}
		.dice-pip {
			border-radius: 50%;
			background: hsl(var(--theme-bg));
			box-shadow: inset 0 1px 2px #0005;
		}
		.dice-caption {
			margin-top: 3.25rem;
			font-size: 1.5rem;
			font-weight: 600;
			letter-spacing: -0.02em;
		}
		.dingo-roll[open] .dice-stage {
			animation: dice-reveal 1.3s both;
		}
		.dingo-roll[open] .dice-lift {
			animation: dice-bounce 1.1s both;
		}
		.dingo-roll[open] .dice-cube {
			animation: dice-tumble 1.1s cubic-bezier(0.15, 0.65, 0.25, 1) both;
		}
		@keyframes dice-tumble {
			from {
				transform: rotateX(-280deg) rotateY(-480deg) rotateZ(-55deg);
			}
			78% {
				transform: rotateX(-12deg) rotateY(-24deg) rotateZ(5deg);
			}
			to {
				transform: rotateX(-20deg) rotateY(-32deg) rotateZ(0);
			}
		}
		@keyframes dice-bounce {
			0% {
				translate: 0 24px;
				scale: 0.7;
			}
			32% {
				translate: 0 -32px;
				scale: 1.06;
			}
			73% {
				translate: 0 7px;
				scale: 0.97;
			}
			88% {
				translate: 0 -3px;
				scale: 1.01;
			}
			100% {
				translate: 0 0;
				scale: 1;
			}
		}
		@keyframes dice-reveal {
			0% {
				opacity: 0;
			}
			12%,
			85% {
				opacity: 1;
			}
			100% {
				opacity: 0;
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.dingo-roll[open] :is(.dice-stage, .dice-lift, .dice-cube) {
				animation: none;
			}

			button,
			.spira-filters button::after {
				transition: none;
			}
		}
	</style>
</spira-explorer>
