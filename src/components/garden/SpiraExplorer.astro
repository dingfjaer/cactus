---
import type { CollectionEntry } from "astro:content";
import DingoRoll from "./DingoRoll.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getPostSortDate } from "@/data/post";
interface Props {
	posts: CollectionEntry<"post">[];
	currentPage: number;
}
const { posts, currentPage } = Astro.props;
const base = `${import.meta.env.BASE_URL}posts/`;
---

<spira-explorer data-page={currentPage} data-base={base}>
	<div data-enhanced hidden>
		<div class="spira-toolbar">
			<div class="spira-filters" role="group" aria-label="Filtrer innlegg">
				<button type="button" data-filter="alle" aria-pressed="true">Alle</button>
				<button type="button" data-filter="dingaling" aria-pressed="false">NerDing</button>
				<button type="button" data-filter="ki-oppsummert" aria-pressed="false">KI-oppsummert</button
				>
			</div>
			<button class="dingo" type="button" data-draw aria-label="Dingo – trekk innlegg"
				><span aria-hidden="true">🎲</span> Dingo</button
			>
		</div>
		<div class="spira-description" data-description hidden>
			<h2 data-filter-title></h2><p data-filter-description></p>
		</div>
		<div class="dingo-heading" data-dingo hidden>
			<h2 data-dingo-title></h2>
			<div class="dingo-actions">
				<button type="button" data-again>Trekk på nytt</button><span aria-hidden="true">·</span
				><button type="button" data-latest>Tilbake til nyeste</button>
			</div>
		</div>
		<p class="sr-only" role="status" aria-live="polite" data-status></p>
		<div data-results></div>
		<nav class="spira-pagination" data-pagination aria-label="Bla i filtrerte innlegg">
			<button type="button" data-prev>← Forrige</button><span data-page-label></span><button
				type="button"
				data-next>Neste →</button
			>
		</nav>
	</div>
	<DingoRoll />
	<div data-fallback><slot /></div>
	<template data-posts>
		<ul>
			{
				posts.map((post) => (
					<li
						data-id={post.id}
						data-type={post.data.contentType}
						data-year={getPostSortDate(post).getFullYear()}
						data-pinned={String(post.data.pinned)}
						class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2"
					>
						<PostPreview post={post} />
					</li>
				))
			}
		</ul>
	</template>
	<script>
		import "../../scripts/spira";
	</script>
	<style>
		[hidden] {
			display: none !important;
		}
		spira-explorer {
			display: block;
		}
		.spira-toolbar,
		.spira-filters,
		.dingo-actions,
		.spira-pagination {
			display: flex;
			align-items: center;
			flex-wrap: wrap;
			gap: 0.5rem;
		}
		.spira-toolbar {
			justify-content: space-between;
			gap: 0.75rem;
			margin-bottom: 1.75rem;
		}
		button {
			min-height: 42px;
			padding: 0.5rem 0.75rem;
			border-radius: 0.6rem;
			font-size: 0.85rem;
			transition:
				background 0.15s,
				color 0.15s;
		}
		.spira-filters {
			flex: 1;
			flex-wrap: nowrap;
			gap: 0.5rem;
			border-bottom: 1px solid hsl(var(--theme-text) / 0.25);
		}
		button:hover:not(:disabled) {
			color: hsl(var(--theme-accent));
			background: hsl(var(--theme-text) / 0.08);
		}
		.spira-filters button {
			position: relative;
			padding: 0.7rem 0.5rem;
			border-radius: 0;
			white-space: nowrap;
			color: hsl(var(--theme-text) / 0.65);
		}
		.spira-filters button:hover:not(:disabled),
		.spira-filters button[aria-pressed="true"] {
			color: hsl(var(--theme-accent-2));
			background: transparent;
		}
		.spira-filters button::after {
			content: "";
			position: absolute;
			inset-inline: 0;
			bottom: -1px;
			height: 3px;
			background: hsl(var(--theme-accent));
			opacity: 0;
			transition: opacity 0.15s;
		}
		.spira-filters button[aria-pressed="true"]::after {
			opacity: 1;
		}
		button:focus-visible {
			outline: 2px solid hsl(var(--theme-accent));
			outline-offset: 3px;
		}
		.dingo {
			color: hsl(var(--theme-accent));
			border: 1px dashed hsl(var(--theme-accent) / 0.55);
		}
		.spira-description {
			margin-bottom: 1.8rem;
			font-size: 0.9rem;
			line-height: 1.65;
		}
		h2 {
			color: hsl(var(--theme-accent-2));
			font-weight: 600;
		}
		.spira-description p {
			margin-top: 0.3rem;
		}
		.dingo-heading {
			margin-bottom: 1.6rem;
			padding: 1rem;
			border-radius: 0.8rem;
			background: hsl(var(--theme-accent) / 0.06);
			border-inline-start: 2px solid hsl(var(--theme-accent));
		}
		.dingo-actions {
			gap: 0.3rem;
			margin: 0.4rem 0 -0.4rem -0.5rem;
			color: hsl(var(--theme-accent));
		}
		.dingo-actions button {
			padding-inline: 0.5rem;
		}
		.spira-pagination {
			justify-content: space-between;
			gap: 0.25rem;
			margin-top: 2rem;
			font-size: 0.85rem;
		}
		button:disabled {
			opacity: 0.35;
		}
		@media (prefers-reduced-motion: reduce) {
			button,
			.spira-filters button::after {
				transition: none;
			}
		}
	</style>
</spira-explorer>
