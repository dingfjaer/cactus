---
const diceFaces = [
	{ side: "front", pips: [1, 3, 5, 7, 9] },
	{ side: "back", pips: [1, 9] },
	{ side: "right", pips: [1, 5, 9] },
	{ side: "left", pips: [1, 3, 7, 9] },
	{ side: "top", pips: [5] },
	{ side: "bottom", pips: [1, 3, 4, 6, 7, 9] },
];
---

<dialog class="dingo-roll" data-roll aria-label="Terningkast" tabindex="-1">
	<div class="dice-stage" aria-hidden="true">
		<div class="dice-lift">
			<div class="dice-cube">
				<div class="dice-orientation">
					{
						diceFaces.map((face) => (
							<div class={`dice-face dice-face--${face.side}`}>
								{face.pips.map((pip) => (
									<span
										class="dice-pip"
										style={`grid-area: ${Math.ceil(pip / 3)} / ${((pip - 1) % 3) + 1}`}
									/>
								))}
							</div>
						))
					}
				</div>
			</div>
			<p class="dice-caption" data-roll-result>Dingo!</p>
		</div>
	</div>
</dialog>
<style>
	.dingo-roll {
		--dice-size: clamp(112px, 18vw, 152px);
		--dice-half: calc(var(--dice-size) / 2);
		position: fixed;
		inset: 0;
		margin: auto;
		width: min(360px, 90vw);
		height: min(340px, 80dvh);
		max-width: none;
		max-height: none;
		padding: 0;
		border: 0;
		overflow: visible;
		background: transparent;
		color: hsl(var(--theme-accent));
		outline: none;
	}
	.dingo-roll::backdrop {
		background: hsl(var(--theme-bg) / 0.7);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}
	.dice-stage {
		width: 100%;
		height: 100%;
		display: grid;
		place-content: center;
		justify-items: center;
		perspective: 650px;
	}
	.dice-lift {
		transform-style: preserve-3d;
	}
	.dice-cube {
		position: relative;
		width: var(--dice-size);
		height: var(--dice-size);
		transform-style: preserve-3d;
		transform: rotateX(0) rotateY(0);
	}
	.dice-face {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template: repeat(3, 1fr) / repeat(3, 1fr);
		gap: 12%;
		padding: 17%;
		border-radius: 15%;
		background: linear-gradient(145deg, #ffffff38, #00000012), hsl(var(--theme-accent));
		border: 1px solid hsl(var(--theme-bg) / 0.18);
		box-shadow: inset 0 0 12px #ffffff25;
		backface-visibility: hidden;
	}
	.dice-face--front {
		transform: translateZ(var(--dice-half));
	}
	.dice-face--back {
		transform: rotateY(180deg) translateZ(var(--dice-half));
	}
	.dice-face--right {
		transform: rotateY(90deg) translateZ(var(--dice-half));
	}
	.dice-face--left {
		transform: rotateY(-90deg) translateZ(var(--dice-half));
	}
	.dice-face--top {
		transform: rotateX(90deg) translateZ(var(--dice-half));
	}
	.dice-face--bottom {
		transform: rotateX(-90deg) translateZ(var(--dice-half));
	}
	.dice-pip {
		border-radius: 50%;
		background: hsl(var(--theme-bg));
		box-shadow: inset 0 1px 2px #0005;
	}
	.dice-caption {
		margin-top: 3.25rem;
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.dingo-roll[open] .dice-stage {
		animation: dice-reveal 1.6s both;
	}
	.dingo-roll[open] .dice-lift {
		animation: dice-bounce 1.1s both;
	}
	.dingo-roll[open] .dice-cube {
		animation: dice-tumble 1.1s cubic-bezier(0.15, 0.65, 0.25, 1) both;
	}
	@keyframes dice-tumble {
		from {
			transform: rotateX(-280deg) rotateY(-480deg) rotateZ(-55deg);
		}
		78% {
			transform: rotateX(-12deg) rotateY(-24deg) rotateZ(5deg);
		}
		to {
			transform: rotateX(0) rotateY(0) rotateZ(0);
		}
	}
	@keyframes dice-bounce {
		0% {
			translate: 0 24px;
			scale: 0.7;
		}
		32% {
			translate: 0 -32px;
			scale: 1.06;
		}
		73% {
			translate: 0 7px;
			scale: 0.97;
		}
		88% {
			translate: 0 -3px;
			scale: 1.01;
		}
		100% {
			translate: 0 0;
			scale: 1;
		}
	}
	@keyframes dice-reveal {
		0% {
			opacity: 0;
		}
		12%,
		85% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}

	.dice-orientation {
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
		transform: var(--dice-result, rotateY(0deg));
	}
	.dice-caption {
		text-align: center;
		white-space: nowrap;
	}
	.dingo-roll[open] .dice-caption {
		animation: result-reveal 1.1s both;
	}
	@keyframes result-reveal {
		0%,
		75% {
			opacity: 0;
		}
		100% {
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.dingo-roll[open] :is(.dice-stage, .dice-lift, .dice-cube, .dice-caption) {
			animation: none;
		}
	}
</style>
