---
import CaretLeft from "@/assets/phosphor/caret-left.svg";
import CaretRight from "@/assets/phosphor/caret-right.svg";
---
<div class="media-gallery">
  <slot />
  <dialog class="media-viewer" aria-label="Stor visning av bilde eller video">
    <div class="viewer-bar">
      <div class="viewer-navigation" role="group" aria-label="Bla mellom bilder og videoer">
        <button class="viewer-prev" type="button" aria-label="Forrige bilde eller video"><CaretLeft aria-hidden="true" /></button>
        <span class="viewer-position" aria-live="polite" aria-atomic="true"></span>
        <button class="viewer-next" type="button" aria-label="Neste bilde eller video"><CaretRight aria-hidden="true" /></button>
      </div>
      <p class="viewer-status" role="status"></p>
      <button class="viewer-close" type="button" autofocus aria-label="Lukk stor visning">Lukk ×</button>
    </div>
    <div class="viewer-content"></div>
  </dialog>
</div>
<script>
function setupViewers() {
  document.querySelectorAll<HTMLElement>('.media-gallery').forEach(root => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
    const content = root.querySelector<HTMLElement>('.viewer-content')!;
    const status = root.querySelector<HTMLElement>('.viewer-status')!;
    const close = root.querySelector<HTMLButtonElement>('.viewer-close')!;
    const previous = root.querySelector<HTMLButtonElement>('.viewer-prev')!;
    const next = root.querySelector<HTMLButtonElement>('.viewer-next')!;
    const position = root.querySelector<HTMLElement>('.viewer-position')!;
    const items = () => [...root.querySelectorAll<HTMLElement>('[data-media-open]')]
      .filter(item => !item.closest('figure')?.hidden && item.getClientRects().length > 0);
    let opener: HTMLElement | null = null;
    let generation = 0;
    let controller: AbortController | undefined;
    let disposePlayer = () => {};
    let previousOverflow = '';
    const safeURL = (value: string) => {
      const url = new URL(value);
      if (url.protocol !== 'https:' || !url.hostname.endsWith('.jottacloud.com')) throw Error('Uventet medieadresse');
      return url.href;
    };
    const cleanup = () => {
      generation++;
      controller?.abort();
      disposePlayer(); disposePlayer = () => {};
      const video = content.querySelector('video');
      if(video) { video.pause(); video.removeAttribute('src'); video.load(); }
      content.replaceChildren();
    };
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => { cleanup(); document.body.style.overflow = previousOverflow; opener?.focus({preventScroll:true}); });
    // Switching media tears down the old player/request before loading the next.
    const showMedia = async (trigger: HTMLElement) => {
      const thumbnail = trigger.querySelector('img');
      if(!thumbnail) return;
      cleanup();
      opener = trigger;
      const visible = items();
      const index = visible.indexOf(trigger);
      previous.disabled = index <= 0;
      next.disabled = index < 0 || index >= visible.length - 1;
      position.textContent = `${index + 1} / ${visible.length}`;
      const current = generation;
      status.textContent = '';
      if(trigger.dataset.kind !== 'video') {
        const image = thumbnail.cloneNode(true) as HTMLImageElement;
        image.removeAttribute('class'); image.removeAttribute('style');
        image.loading = 'eager'; image.sizes = '100vw';
        content.replaceChildren(image);
        return;
      }
      const video = document.createElement('video');
      video.controls = true; video.playsInline = true; video.preload = 'metadata';
      video.crossOrigin = 'anonymous'; video.poster = thumbnail.currentSrc || thumbnail.src;
      video.setAttribute('aria-label', thumbnail.alt);
      content.replaceChildren(video);
      status.textContent = 'Laster video …';
      controller = new AbortController();
      const signal = AbortSignal.any([controller.signal, AbortSignal.timeout(25000)]);
      const fail = () => { if(current === generation) status.textContent = 'Videoen kunne ikke lastes. Lukk og åpne den på nytt for å prøve igjen.'; };
      video.addEventListener('error', fail);
      video.addEventListener('canplay', () => { if(current === generation) status.textContent = 'Trykk ▶ for å spille av.'; });
      video.addEventListener('playing', () => { if(current === generation) status.textContent = ''; });
      try {
        // Resolve a fresh signed stream at open time, including paginated albums.
        const share = trigger.dataset.share!;
        if(!/^[a-zA-Z0-9_-]+$/.test(share)) throw Error('Ugyldig album');
        let cursor = '';
        const seen = new Set<string>();
        let source = '';
        while(true) {
          const response = await fetch(`https://api.jottacloud.com/photos/v1/public/${share}/${encodeURIComponent(cursor)}?order=ASC&limit=100&comments=false`, {credentials:'omit',cache:'no-store',signal});
          if(!response.ok) throw Error('Album kunne ikke lastes');
          const album = await response.json();
          if(!Array.isArray(album.photos)) throw Error('Uventet album');
          const item = album.photos.find((p: {id: string}) => p.id === trigger.dataset.id);
          if(item) {
            if(item.deleted || item.hidden || item.content !== 'video') throw Error('Video utilgjengelig');
            source = safeURL(item.video_url); break;
          }
          if(album.photos.length < 100) throw Error('Video fjernet');
          const next = album.photos.at(-1)?.timestamp;
          if(typeof next !== 'string' || !/^\d+$/.test(next) || seen.has(next)) throw Error('Uventet paginering');
          seen.add(next); cursor = next;
        }
        if(current !== generation) return;
        if(video.canPlayType('application/vnd.apple.mpegurl')) video.src = source;
        else {
          const moduleURL = 'https://cdn.jsdelivr.net/npm/hls.js@1.7.3/dist/hls.mjs';
          const {default:Hls} = await import(/* @vite-ignore */ moduleURL);
          if(current !== generation) return;
          if(!Hls.isSupported()) throw Error('HLS støttes ikke');
          const hls = new Hls({maxBufferLength:10,maxMaxBufferLength:20});
          disposePlayer = () => hls.destroy();
          hls.on(Hls.Events.ERROR, (_: unknown, data: {fatal: boolean}) => { if(data.fatal) { fail(); hls.destroy(); } });
          hls.loadSource(source); hls.attachMedia(video);
        }
      } catch { fail(); }
    };
    const move = (direction: number) => {
      const visible = items();
      const target = visible[visible.indexOf(opener!) + direction];
      if (target) void showMedia(target);
    };
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    dialog.addEventListener('keydown', event => {
      if (event.altKey || event.ctrlKey || event.metaKey || (event.target as Element).closest('video')) return;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault(); move(event.key === 'ArrowLeft' ? -1 : 1);
      }
    });
    root.addEventListener('click', event => {
      const trigger = (event.target as Element).closest<HTMLElement>('[data-media-open]');
      if (!trigger || !root.contains(trigger) || dialog.open) return;
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      dialog.showModal();
      void showMedia(trigger);
    });
    document.addEventListener('astro:before-swap', () => { if(dialog.open) { dialog.close(); cleanup(); } }, {once:true});
  });
}
setupViewers();
document.addEventListener('astro:page-load', setupViewers);
</script>
<style>
.media-viewer { position:fixed; inset:0; width:100vw; height:100dvh; max-width:none; max-height:none; margin:0; padding:1rem; border:0; box-sizing:border-box; background:#101010; color:#fff; }
.media-viewer[open] { display:flex; flex-direction:column; gap:.75rem; }
.media-viewer::backdrop { background:#000d; }
.viewer-bar { display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-shrink:0; }
.viewer-navigation { display:flex; align-items:center; gap:.5rem; flex-shrink:0; }
.viewer-navigation button { display:grid; place-items:center; width:44px; height:44px; border:1px solid #ffffff40; border-radius:50%; background:#ffffff15; color:white; cursor:pointer; }
.viewer-navigation button:disabled { opacity:.25; cursor:default; }
.viewer-navigation button:focus-visible { outline:2px solid white; outline-offset:3px; }
.viewer-navigation :global(svg) { width:24px; height:24px; fill:currentColor; }
.viewer-position { min-width:4.5ch; text-align:center; font-size:.8rem; font-variant-numeric:tabular-nums; }
@media(max-width:639px) { .viewer-bar { flex-wrap:wrap; } .viewer-status:not(:empty) { order:3; width:100%; } }
.viewer-status { margin:0; font-size:.9rem; }
.viewer-close { margin-left:auto; flex-shrink:0; min-width:88px; min-height:44px; padding:.5rem 1rem; border:1px solid #aaa; border-radius:.5rem; background:#222; color:white; cursor:pointer; font:inherit; }
.viewer-close:focus-visible { outline:3px solid white; outline-offset:3px; }
.viewer-content { flex:1; min-height:0; display:flex; align-items:center; justify-content:center; }
.viewer-content :global(img), .viewer-content :global(video) { display:block; width:100%; height:100%; max-width:100%; max-height:100%; object-fit:contain; }
@media (prefers-reduced-motion:no-preference) { .media-viewer[open] { animation:reveal .15s ease-out; } }
@keyframes reveal { from { opacity:0; } to { opacity:1; } }
</style>
